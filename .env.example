# Copy to .env.local and fill in the Aiven service connection values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/defaultdb"
DATABASE_CA_CERT_PATH="./certs/aiven-ca.pem"
# Alternatively set DATABASE_CA_CERT to the PEM certificate (escaped \n supported).
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
PGSSLMODE="verify-full"
DATABASE_POOL_MAX="5"

# Existing authentication and realtime settings
JWT_SECRET=""
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
NEXT_PUBLIC_SITE_URL="https://cricklive-seven.vercel.app"
# Optional error monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
